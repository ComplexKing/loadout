.gradle/
build/
out/
# Eclipse compiles into bin/, but our launcher shims live there too. Ignoring the
# contents rather than the directory is what makes the negations below work -- git
# will not re-include a file whose parent directory is itself excluded.
bin/*
!bin/loadout
!bin/loadout.cmd
!bin/install.ps1

.idea/
*.iml
*.ipr
*.iws
.settings/
.classpath
.project
.vscode/

*.DS_Store

# Never commit anything holding credentials. Loadout keeps accounts under the user's
# home directory, not the project, but this is here so a stray copy can't slip in.
accounts.json
*.token
.env

# Electron app dependencies and build output.
app/node_modules/
app/dist/

# jlink output, rebuilt by scripts/runtime.mjs
app/runtime/
build/release/
