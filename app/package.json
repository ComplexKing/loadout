{
  "name": "loadout-app",
  "version": "0.1.0",
  "description": "Desktop interface for Loadout",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.loadout.app",
    "productName": "Loadout",
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "//icon": "electron-builder picks icon.ico on Windows and the largest PNG elsewhere. Without assets in files above, the window icon path would resolve to nothing in a packaged build.",
    "icon": "assets/icon.ico",
    "extraResources": [
      {
        "from": "../build/dist/loadout.jar",
        "to": "loadout.jar"
      }
    ],
    "win": { "target": "nsis", "icon": "assets/icon.ico" },
    "linux": { "target": "AppImage", "category": "Game", "icon": "assets/icon-512.png" },
    "mac": { "target": "dmg", "icon": "assets/icon-512.png" }
  }
}
