{
  "name": "loadout-app",
  "version": "0.1.0",
  "description": "Desktop interface for Loadout",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "node ../scripts/runtime.mjs && electron-builder",
    "runtime": "node ../scripts/runtime.mjs"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.loadout.app",
    "productName": "Loadout",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "icon": "assets/icon.ico",
    "extraResources": [
      {
        "from": "../build/dist/loadout.jar",
        "to": "loadout.jar"
      },
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Loadout-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "assets/icon-512.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Loadout"
    },
    "directories": {
      "output": "../build/release"
    }
  }
}
